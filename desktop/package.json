{
  "name": "slipwright-agent",
  "productName": "Slipwright Agent",
  "version": "0.1.0",
  "description": "Lends this computer to a Slipwright account: writes phases with your own model, builds what it can.",
  "author": "Slipwright",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "build:cli": "node scripts/build-cli.mjs"
  },
  "dependencies": {
    "tar": "^7.4.3",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vitest": "^3.2.4",
    "typescript": "~5.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "esbuild": "^0.25.0"
  }
}

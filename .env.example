# Copy to .env; docker compose reads it. All optional (keys can be entered in the UI).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Fernet key for stored tokens; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SLIPWRIGHT_SECRET_KEY=
# live (default) or scripted (offline, canned model replies)
SLIPWRIGHT_PROVIDER=live
# Folder with your local checkouts; mounted as /repos inside the container.
# Register a project at <this folder>/myapp with repo_path = /repos/myapp
SLIPWRIGHT_REPOS=./repos

# Where everything is kept. Empty means the SQLite file under the state directory, which
# is right for one team on one machine. A hosted installation -- accounts signing up,
# each bringing their own model keys -- points this at a server and starts compose with
# `--profile postgres`:
# SLIPWRIGHT_DATABASE_URL=postgresql+psycopg://slipwright:slipwright@postgres/slipwright
SLIPWRIGHT_DATABASE_URL=

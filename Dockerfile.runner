# The image a project's own build and test commands run in.
#
# Separate from the server image on purpose. This one is entered by commands a *model*
# wrote, so it carries the toolchains a project needs and nothing that belongs to
# Slipwright: no source, no state directory, no credentials, no `gh`, no ssh keys.
#
#   docker build -f Dockerfile.runner -t slipwright-runner:local .
#
# Point the server at it with SLIPWRIGHT_RUNNER=docker (and
# SLIPWRIGHT_RUNNER_IMAGE if you have built your own). The container is started with no
# network, no capabilities, a read-only root filesystem and one writable mount -- the
# worktree -- so what is installed here is the whole of what a command can use.

# The Android SDK and Gradle, as in Dockerfile's stage 2 and kept in step with it: the
# Architect is told what the *server* has (gates/toolchains.py), so this image must carry
# the same. Read-only here, so only these platforms exist; and Gradle fetches the Android
# plugin from Google's Maven, which needs SLIPWRIGHT_RUNNER_NETWORK=bridge.
FROM --platform=$BUILDPLATFORM eclipse-temurin:21-jdk AS android
ARG ANDROID_TOOLS=16111833
ARG ANDROID_TOOLS_SHA1=e025545c62a8e64c7559119566a569fb1dec5f60
ARG ANDROID_PACKAGES="platforms;android-35 platforms;android-36 build-tools;35.0.0 build-tools;36.0.0"
ARG GRADLE_VERSION=8.14.3
ARG GRADLE_SHA256=bd71102213493060956ec229d946beee57158dbd89d0e62b91bca0fa2c5f3531
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSLo /tmp/tools.zip \
         "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_TOOLS}_latest.zip" \
    && echo "${ANDROID_TOOLS_SHA1}  /tmp/tools.zip" | sha1sum -c - \
    && mkdir -p /opt/android-sdk/cmdline-tools \
    && unzip -q /tmp/tools.zip -d /opt/android-sdk/cmdline-tools \
    && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest \
    && rm /tmp/tools.zip
RUN yes | /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager \
         --sdk_root=/opt/android-sdk --licenses > /dev/null \
    && /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=/opt/android-sdk \
         ${ANDROID_PACKAGES} > /tmp/sdk.log || { cat /tmp/sdk.log; exit 1; }
# sdkmanager itself is only needed to get here, and nothing may install anything later
RUN rm -rf /opt/android-sdk/cmdline-tools
RUN curl -fsSLo /tmp/gradle.zip \
         "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
    && echo "${GRADLE_SHA256}  /tmp/gradle.zip" | sha256sum -c - \
    && mkdir -p /opt/gradle \
    && unzip -q /tmp/gradle.zip -d /opt/gradle \
    && rm /tmp/gradle.zip

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    # the worktree is mounted here and is the only writable place there is
    HOME=/work

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        make \
        build-essential \
        python3 \
        python3-venv \
        python3-pip \
        nodejs \
        npm \
    && rm -rf /var/lib/apt/lists/*

# uv, for projects whose profile builds with it
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Java, Gradle and the Android SDK, for mobile projects
COPY --from=eclipse-temurin:21-jdk /opt/java/openjdk /opt/java/openjdk
COPY --from=android /opt/android-sdk /opt/android-sdk
COPY --from=android /opt/gradle /opt/gradle
RUN ln -s /opt/gradle/gradle-*/bin/gradle /usr/local/bin/gradle
ENV JAVA_HOME=/opt/java/openjdk \
    ANDROID_HOME=/opt/android-sdk \
    PATH="/opt/java/openjdk/bin:${PATH}"

# The uid the server starts the container as. Files the command writes into the mounted
# worktree are then owned by this uid on the host rather than by root.
RUN useradd --uid 1000 --create-home --shell /bin/sh runner
USER 1000:1000

WORKDIR /work
CMD ["sh"]

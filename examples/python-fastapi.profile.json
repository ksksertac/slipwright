{
  "language": "python",
  "package_manager": "uv",
  "build_cmd": "uv sync && uv run ruff check . && uv run mypy",
  "test_cmd": "uv run pytest -q",
  "run_cmd": "uv run uvicorn app.main:app --host 127.0.0.1 --port {port}",
  "port": 8000,
  "roles": {
    "analyst": {
      "model": "claude-sonnet-5",
      "thinking_depth": "medium",
      "permissions": ["read_files", "run_commands"]
    },
    "planner": {
      "model": "claude-opus-5",
      "thinking_depth": "high",
      "permissions": ["read_files"]
    },
    "developer": {
      "model": "claude-opus-5",
      "thinking_depth": "high",
      "permissions": ["read_files", "write_files", "run_commands"]
    },
    "qa": {
      "model": "claude-sonnet-5",
      "thinking_depth": "medium",
      "permissions": ["read_files", "write_files", "run_commands"]
    },
    "devops": {
      "model": "claude-haiku-4-5-20251001",
      "thinking_depth": "low",
      "permissions": ["read_files", "run_commands", "network", "git_push"]
    }
  }
}

{
  "$defs": {
    "Permission": {
      "enum": [
        "read_files",
        "write_files",
        "run_commands",
        "network",
        "git_push",
        "jira"
      ],
      "title": "Permission",
      "type": "string"
    },
    "RoleConfig": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "description": "Model identifier passed to the provider.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which provider serves this role (anthropic, openai, deepseek); unset means the configured default.",
          "title": "Provider"
        },
        "thinking_depth": {
          "$ref": "#/$defs/ThinkingDepth"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/Permission"
          },
          "title": "Permissions",
          "type": "array"
        },
        "standards_budget": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Token budget for the standards sections retrieved into this role's prompt; unset means the value under Settings \u2192 Standards.",
          "title": "Standards Budget"
        },
        "retries": {
          "default": 2,
          "description": "Attempts after a timeout, provider error or malformed output (exponential backoff) before the job fails.",
          "maximum": 5,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "thinking_depth"
      ],
      "title": "RoleConfig",
      "type": "object"
    },
    "RoleName": {
      "enum": [
        "po",
        "architect",
        "backend",
        "designer",
        "web_ui",
        "mobile_ui",
        "qa",
        "devops",
        "supervisor"
      ],
      "title": "RoleName",
      "type": "string"
    },
    "ThinkingDepth": {
      "enum": [
        "off",
        "low",
        "medium",
        "high",
        "max"
      ],
      "title": "ThinkingDepth",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "language": {
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "package_manager": {
      "minLength": 1,
      "title": "Package Manager",
      "type": "string"
    },
    "build_cmd": {
      "minLength": 1,
      "title": "Build Cmd",
      "type": "string"
    },
    "test_cmd": {
      "minLength": 1,
      "title": "Test Cmd",
      "type": "string"
    },
    "run_cmd": {
      "description": "Command that starts the project; must contain {port}.",
      "minLength": 1,
      "title": "Run Cmd",
      "type": "string"
    },
    "port": {
      "description": "Default port the project listens on.",
      "maximum": 65535,
      "minimum": 1024,
      "title": "Port",
      "type": "integer"
    },
    "roles": {
      "additionalProperties": {
        "$ref": "#/$defs/RoleConfig"
      },
      "propertyNames": {
        "$ref": "#/$defs/RoleName"
      },
      "title": "Roles",
      "type": "object"
    }
  },
  "required": [
    "language",
    "package_manager",
    "build_cmd",
    "test_cmd",
    "run_cmd",
    "port",
    "roles"
  ],
  "title": "Profile",
  "type": "object"
}
